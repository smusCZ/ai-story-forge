# AI Story Forge – Environment variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://storyforge:storyforge@localhost:5432/storyforge

# Redis (optional for now)
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible or Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# For local free models with Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.3

# Uploads
UPLOAD_ROOT=/tmp/ai-story-forge/uploads

# App security defaults
DEBUG=false
# Pydantic Settings expects a JSON array for list-valued environment variables.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false
